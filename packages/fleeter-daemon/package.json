{
  "name": "fleeter-daemon",
  "version": "0.1.0",
  "description": "Central daemon for Fleeter - manages Flutter sessions, agents, and processes",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fleeter-daemon": "dist/bin/daemon.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/bin/daemon.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "uuid": "^10.0.0",
    "commander": "^12.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.1.70",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
