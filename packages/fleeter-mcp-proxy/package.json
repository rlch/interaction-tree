{
  "name": "fleeter-mcp-proxy",
  "version": "0.1.0",
  "description": "MCP proxy for Fleeter - connects LLM clients to the Fleeter daemon",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fleeter-mcp-proxy": "dist/bin/proxy.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/bin/proxy.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.18.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
